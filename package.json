{
  "name": "ayr-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "referentie": "node tools/serveer.mjs referentie 3000",
    "beelden:proef": "node tools/zet_beelden_op_blob.mjs --proef",
    "beelden": "node tools/zet_beelden_op_blob.mjs",
    "controleer:referentie": "node tools/controleer_referentie.mjs",
    "tekstknopen": "node tools/tekstknopen.mjs referentie/site-versie-tom",
    "vergelijk": "node tools/vergelijk.mjs",
    "controles": "node tools/controles/alles.mjs",
    "test": "node --test \"tools/**/*.test.mjs\" \"packages/*/test/*.test.mjs\"",
    "typen": "pnpm --filter @ayr/content-schema genereer"
  },
  "devDependencies": {
    "@vercel/blob": "^1.1.1",
    "node-html-parser": "^7.0.1",
    "playwright": "^1.56.0",
    "sharp": "^0.34.4"
  }
}
