{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schema/proef",
  "title": "Proefschema voor de omzetter",
  "description": "Een klein, verzonnen model met elk sleutelwoord dat de omzetter kent. Niet het contentmodel van AYR.",
  "type": "object",
  "required": ["boeken"],
  "properties": {
    "boeken": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Boek" } },
    "woorden": { "$ref": "#/$defs/Woorden" },
    "boom": { "$ref": "#/$defs/Tak" },
    "bijgewerkt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "Tweetalig": {
      "description": "Een tekst in twee talen.",
      "type": "object",
      "required": ["nl"],
      "properties": { "nl": { "type": "string" }, "en": { "type": "string" } },
      "additionalProperties": false
    },
    "Opgemaakt": { "description": "Hetzelfde, met opmaak.", "allOf": [{ "$ref": "#/$defs/Tweetalig" }] },
    "Woorden": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Tweetalig" } },
    "Boek": {
      "type": "object",
      "required": ["id", "titel", "soort", "prijs_eur", "oud", "nieuw"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "nummer": { "type": "string", "pattern": "^BK-\\d{4}-\\d{4}$" },
        "titel": { "$ref": "#/$defs/Tweetalig", "description": "De titel op de kaft." },
        "inleiding": { "$ref": "#/$defs/Opgemaakt" },
        "soort": { "enum": ["roman", "gids", "atlas"] },
        "status": { "type": "integer", "enum": [301, 302] },
        "prijs_eur": { "type": "number", "exclusiveMinimum": 0 },
        "korting_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "bladzijden": { "type": "integer", "minimum": 1 },
        "zichtbaar": { "type": "boolean", "default": true },
        "kleur": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "land": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "week": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
        "code": { "type": "string", "maxLength": 4, "readOnly": true },
        "naam": { "type": "string", "minLength": 2 },
        "verschenen": { "type": "string", "format": "date" },
        "omslag": { "type": "string", "format": "uri" },
        "contact": { "type": "string", "format": "email", "examples": ["naam@example.com"] },
        "trefwoorden": { "type": "array", "items": { "type": "string" }, "maxItems": 3 },
        "maten": {
          "type": "object",
          "description": "Een object in een object, met eigen verplichte velden.",
          "required": ["breedte"],
          "properties": { "breedte": { "type": "integer" }, "hoogte": { "type": "integer" } }
        },
        "uitslag": { "type": "object", "properties": { "vast": { "type": "boolean" } }, "additionalProperties": { "enum": ["past", "past_niet"] } },
        "opties": { "type": "object" },
        "losse_lijst": { "type": "array" },
        "oud": {},
        "nieuw": {}
      }
    },
    "Tak": {
      "description": "Wijst naar zichzelf.",
      "type": "object",
      "required": ["naam"],
      "properties": { "naam": { "type": "string" }, "takken": { "type": "array", "items": { "$ref": "#/$defs/Tak" } } },
      "additionalProperties": false
    }
  }
}
